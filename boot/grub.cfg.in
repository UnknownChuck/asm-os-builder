# ASM OS - UEFI boot menu (GRUB)
search --no-floppy --set=root --file /ASM_OS_LIVE

set default=0
set timeout=5

# Branded graphical menu; silently falls back to text if the font is missing.
insmod all_video
insmod gfxterm
insmod png
set gfxmode=auto
set gfxpayload=keep
if loadfont /boot/grub/unicode.pf2 ; then
    terminal_output gfxterm
    background_image /boot/grub/bootsplash.png
fi

set color_normal=light-gray/black
set color_highlight=white/dark-gray
set menu_color_normal=light-gray/black
set menu_color_highlight=white/blue

menuentry "ASM OS @VERSION@ (Live)" {
    linux  /live/vmlinuz @CMDLINE@
    initrd /live/initrd.img
}
menuentry "ASM OS (Safe graphics - nomodeset)" {
    linux  /live/vmlinuz @CMDLINE@ nomodeset
    initrd /live/initrd.img
}
menuentry "ASM OS (Copy to RAM - needs 2 GB or more)" {
    linux  /live/vmlinuz @CMDLINE@ toram
    initrd /live/initrd.img
}
menuentry "UEFI firmware settings" {
    fwsetup
}
