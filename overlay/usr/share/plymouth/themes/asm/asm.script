# ASM OS Plymouth splash: dark gradient, centred logo, thin accent progress bar.
Window.SetBackgroundTopColor(0.027, 0.039, 0.063);
Window.SetBackgroundBottomColor(0.067, 0.102, 0.165);

logo.image  = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30);

bar.image  = Image("bar.png");
bar.width  = bar.image.GetWidth();
bar.height = bar.image.GetHeight();
bar.sprite = Sprite();
bar.sprite.SetX(Window.GetX() + Window.GetWidth()  / 2 - bar.width / 2);
bar.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 + logo.image.GetHeight() / 2);

fun progress_callback(duration, progress) {
    w = Math.Int(bar.width * progress);
    if (w < 1) w = 1;
    bar.sprite.SetImage(bar.image.Scale(w, bar.height));
}
Plymouth.SetBootProgressFunction(progress_callback);
