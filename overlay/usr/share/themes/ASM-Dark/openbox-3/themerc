# ASM-Dark - Openbox theme for ASM OS (ASM Industries)
# Palette: bg #0b0e14  panel #141c28  line #1f2a3a  accent #00a3ff  text #e6edf3

border.width: 1
padding.width: 8
padding.height: 5
window.handle.width: 3
window.client.padding.width: 0
menu.overlap: 2
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 3

window.active.border.color: #00a3ff
window.inactive.border.color: #1f2a3a
window.active.client.color: #0b0e14
window.inactive.client.color: #0b0e14
window.active.title.separator.color: #1f2a3a
window.inactive.title.separator.color: #1f2a3a

# Titlebars
window.active.title.bg: flat solid
window.active.title.bg.color: #141c28
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #0f151e
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: #e6edf3
window.inactive.label.text.color: #6b7686
window.label.text.justify: left

# Bottom handle and grips
window.active.handle.bg: flat solid
window.active.handle.bg.color: #141c28
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #0f151e
window.active.grip.bg: flat solid
window.active.grip.bg.color: #1f2a3a
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #172030

# Buttons (active window)
window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #8b98a9
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #1f2c40
window.active.button.hover.image.color: #ffffff
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #00a3ff
window.active.button.pressed.image.color: #0b0e14
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #3b4658
window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.unpressed.image.color: #00a3ff
window.active.button.toggled.hover.bg: flat solid
window.active.button.toggled.hover.bg.color: #1f2c40
window.active.button.toggled.hover.image.color: #00a3ff
window.active.button.toggled.pressed.bg: flat solid
window.active.button.toggled.pressed.bg.color: #00a3ff
window.active.button.toggled.pressed.image.color: #0b0e14

# Buttons (inactive window)
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #4b5666
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #172030
window.inactive.button.hover.image.color: #c0c8d4
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #1f2c40
window.inactive.button.pressed.image.color: #ffffff
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #2a3646
window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.unpressed.image.color: #4b5666
window.inactive.button.toggled.hover.bg: flat solid
window.inactive.button.toggled.hover.bg.color: #172030
window.inactive.button.toggled.hover.image.color: #c0c8d4
window.inactive.button.toggled.pressed.bg: flat solid
window.inactive.button.toggled.pressed.bg.color: #1f2c40
window.inactive.button.toggled.pressed.image.color: #ffffff

# Menus
menu.border.width: 1
menu.border.color: #1f2a3a
menu.title.bg: flat solid
menu.title.bg.color: #141c28
menu.title.text.color: #00a3ff
menu.title.text.justify: left
menu.items.bg: flat solid
menu.items.bg.color: #0f151e
menu.items.text.color: #d8dee9
menu.items.disabled.text.color: #4b5666
menu.items.active.bg: flat solid
menu.items.active.bg.color: #1b2a40
menu.items.active.text.color: #ffffff
menu.items.active.disabled.text.color: #4b5666
menu.separator.color: #1f2a3a

# On-screen display (alt-tab, desktop switch, resize popup)
osd.border.width: 1
osd.border.color: #00a3ff
osd.bg: flat solid
osd.bg.color: #0f151e
osd.label.bg: parentrelative
osd.label.text.color: #e6edf3
osd.hilight.bg: flat solid
osd.hilight.bg.color: #00a3ff
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #1f2a3a
