# ============================================================================
#  ASM OS package list  (Debian 13 "trixie")
#
#  Syntax (several names per line allowed):
#     name            required  - the build stops if it cannot be installed
#     ?name           optional  - skipped with a warning if unavailable
#     [FLAG] name     only included when WITH_FLAG=1 is set for build.sh
#                     (e.g. "[KICAD] kicad"  ->  sudo WITH_KICAD=1 ./build.sh)
#  Everything is installed with --no-install-recommends, so anything a package
#  only "recommends" must be listed here explicitly.
# ============================================================================

# --- Base system, live boot, memory protection -------------------------------
linux-image-amd64
systemd systemd-sysv udev dbus dbus-user-session libpam-systemd polkitd
live-boot live-config live-config-systemd initramfs-tools zstd
kmod procps psmisc adduser sudo less nano vim-tiny bash-completion
locales tzdata keyboard-configuration ca-certificates
earlyoom
?systemd-timesyncd ?pkexec ?dbus-x11 ?vim

# --- Firmware & microcode (legacy Wi-Fi, GPUs, CPUs) -------------------------
[FIRMWARE] ?firmware-linux-free ?firmware-iwlwifi ?firmware-realtek ?firmware-atheros
[FIRMWARE] ?firmware-brcm80211 ?firmware-misc-nonfree ?firmware-amd-graphics
[FIRMWARE] ?firmware-intel-graphics ?amd64-microcode ?intel-microcode
?wireless-regdb

# --- Graphical stack: Xorg + Openbox + tint2 + LightDM ----------------------
xserver-xorg-core xserver-xorg-input-libinput xserver-xorg-video-fbdev xserver-xorg-video-vesa
xinit xauth x11-xserver-utils x11-utils x11-xkb-utils xkb-data xdg-utils shared-mime-info
libgl1-mesa-dri
openbox tint2 feh xdotool
lightdm lightdm-gtk-greeter
lxterminal xterm pcmanfm gvfs
?lxpolkit ?obconf ?i3lock ?udisks2
# Look & feel
adwaita-icon-theme fonts-dejavu-core
?papirus-icon-theme ?fonts-inter ?fonts-jetbrains-mono ?qt6ct

# --- Internet & networking ---------------------------------------------------
network-manager network-manager-gnome wpasupplicant iw rfkill
?network-manager-openvpn-gnome
openssh-client openssh-server openvpn
curl wget iproute2 iputils-ping traceroute bind9-dnsutils net-tools
?mtr-tiny
# (the browser itself is chosen with BROWSER_PKG in build.sh, default: falkon)

# --- Cybersecurity & network analysis ---------------------------------------
nmap netcat-openbsd tcpdump tshark
?ncat
[WIRESHARK] wireshark

# --- Programming & development ----------------------------------------------
python3 python3-pip python3-venv python3-serial
gcc g++ make pkg-config gdb git
geany
?cmake

# --- Hardware engineering & electronics -------------------------------------
minicom picocom avrdude openocd gcc-avr avr-libc binutils-avr usbutils pciutils
?cutecom ?gerbv ?dfu-util ?stlink-tools ?esptool ?flashrom ?i2c-tools ?sigrok-cli
?ntfs-3g ?exfatprogs ?dosfstools ?parted ?htop ?lsof
[KICAD] kicad
[ARM]   gcc-arm-none-eabi libnewlib-arm-none-eabi

# --- Boot splash --------------------------------------------------------------
[PLYMOUTH] plymouth
